{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTLR",
  "version": "0.2.4",
  "identifier": "org.ytliverecord.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "YTLR", "decorations": true, "width": 1180, "height": 800, "minWidth": 860, "minHeight": 600, "backgroundColor": "#161616" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage", "app", "dmg", "nsis", "msi"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "externalBin": ["binaries/ytlr"], "resources": { "resources/tools/": "tools/" }, "category": "Video", "shortDescription": "Recoverable YouTube live recording", "macOS": { "minimumSystemVersion": "11.0" } },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/jeonjw85/ytlr/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
